# Copy to .env and fill in. `.env` is git-ignored.
POSTGRES_PASSWORD=change-me

# Port the web UI is published on.
WEB_PORT=8080

# Only needed when pulling prebuilt images from GHCR instead of building locally
# (the CD workflow sets these):
# SERVER_IMAGE=ghcr.io/<owner>/daily-stuff-server
# CLIENT_IMAGE=ghcr.io/<owner>/daily-stuff-client
# IMAGE_TAG=latest
